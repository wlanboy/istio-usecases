{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "metadata": {"name": "public-gw", "namespace": "istio-system"},
      "spec": {
        "selector": {"istio": "ingressgateway"},
        "servers": [
          {"port": {"number": 443, "protocol": "HTTPS"}, "hosts": ["shop.local"],
           "tls": {"mode": "SIMPLE", "credentialName": "public-cert"}},
          {"port": {"number": 8443, "protocol": "HTTPS"}, "hosts": ["api.local"],
           "tls": {"mode": "SIMPLE", "credentialName": "shared/shared-cert"}},
          {"port": {"number": 80, "protocol": "HTTP"}, "hosts": ["shop.local"]}
        ]
      }
    },
    {
      "metadata": {"name": "internal-gw", "namespace": "app-default"},
      "spec": {
        "selector": {"istio": "internal-gateway"},
        "servers": [
          {"port": {"number": 443, "protocol": "HTTPS"}, "hosts": ["*"],
           "tls": {"mode": "MUTUAL", "credentialName": "internal-cert"}}
        ]
      }
    },
    {
      "metadata": {"name": "orphan-gw", "namespace": "app-default"},
      "spec": {
        "selector": {"istio": "does-not-exist"},
        "servers": [
          {"port": {"number": 443, "protocol": "HTTPS"}, "hosts": ["*"],
           "tls": {"mode": "SIMPLE", "credentialName": "orphan-cert"}}
        ]
      }
    },
    {
      "metadata": {"name": "no-selector-gw", "namespace": "app-default"},
      "spec": {
        "servers": [
          {"port": {"number": 443, "protocol": "HTTPS"}, "hosts": ["*"],
           "tls": {"mode": "SIMPLE", "credentialName": "never-resolved"}}
        ]
      }
    }
  ]
}
